<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Management System</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            background-color: #f4f7fc;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            background: #ffffff;
            width: 100%;
            max-width: 450px;
            padding: 30px;
            border-radius: 16px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
            position: relative;
        }

        .form-box {
            display: none;
        }

        .form-box.active {
            display: block;
        }

        .profile-icon {
            text-align: center;
            margin-bottom: 15px;
        }

        .profile-icon div {
            width: 50px;
            height: 50px;
            background-color: #e3f2fd;
            border-radius: 50%;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #1976d2;
            font-size: 24px;
        }

        h2 {
            text-align: center;
            color: #1a1a1a;
            margin-bottom: 8px;
            font-size: 24px;
        }

        p.subtitle {
            text-align: center;
            color: #666;
            font-size: 14px;
            margin-bottom: 25px;
        }

        .input-group {
            margin-bottom: 18px;
        }

        .input-group label {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 6px;
        }

        .input-field {
            position: relative;
        }

        .input-field input {
            width: 100%;
            padding: 12px 15px 12px 40px;
            border: 1px solid #ddd;
            border-radius: 8px;
            font-size: 14px;
            outline: none;
            transition: border-color 0.3s;
        }

        .input-field input:focus {
            border-color: #1976d2;
        }

        .input-field span {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #888;
            font-size: 16px;
        }

        .gender-group {
            margin-bottom: 18px;
        }

        .gender-group label.title {
            display: block;
            font-size: 13px;
            font-weight: 600;
            color: #333;
            margin-bottom: 6px;
        }

        .gender-options {
            display: flex;
            border: 1px solid #ddd;
            border-radius: 8px;
            overflow: hidden;
        }

        .gender-options label {
            flex: 1;
            text-align: center;
            padding: 10px;
            font-size: 14px;
            cursor: pointer;
            background: #fff;
            border-right: 1px solid #ddd;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
        }

        .gender-options label:last-child {
            border-right: none;
        }

        .terms {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: #555;
            margin-bottom: 20px;
        }

        .btn {
            width: 100%;
            padding: 12px;
            background-color: #1976d2;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: background 0.3s;
        }

        .btn:hover {
            background-color: #115293;
        }

        .switch-text {
            text-align: center;
            margin-top: 20px;
            font-size: 13px;
            color: #666;
        }

        .switch-text a {
            color: #1976d2;
            text-decoration: none;
            font-weight: 600;
        }

        .switch-text a:hover {
            text-decoration: underline;
        }

        .forgot-link {
            text-align: right;
            margin-bottom: 15px;
            font-size: 13px;
        }

        .forgot-link a {
            color: #1976d2;
            text-decoration: none;
        }

        .forgot-link a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

<div class="container">

    <!-- SIGN UP FORM -->
    <div id="signup-form" class="form-box active">
        <div class="profile-icon">
            <div>👤</div>
        </div>
        <h2>Create Account</h2>
        <p class="subtitle">Join us today! Fill in the details to get started.</p>
        
        <form>
            <div class="input-group">
                <label>Full Name</label>
                <div class="input-field">
                    <span>👤</span>
                    <input type="text" placeholder="Enter your full name" required>
                </div>
            </div>

            <div class="input-group">
                <label>Email Address</label>
                <div class="input-field">
                    <span>✉️</span>
                    <input type="email" placeholder="Enter your email" required>
                </div>
            </div>

            <div class="input-group">
                <label>Password</label>
                <div class="input-field">
                    <span>🔒</span>
                    <input type="password" placeholder="Create a password" required>
                </div>
            </div>

            <div class="input-group">
                <label>Confirm Password</label>
                <div class="input-field">
                    <span>🔒</span>
                    <input type="password" placeholder="Confirm your password" required>
                </div>
            </div>

            <div class="gender-group">
                <label class="title">Gender</label>
                <div class="gender-options">
                    <label><input type="radio" name="gender"> Male</label>
                    <label><input type="radio" name="gender"> Female</label>
                    <label><input type="radio" name="gender"> Others</label>
                </div>
            </div>

            <div class="terms">
                <input type="checkbox" required>
                <span>I agree to the terms & conditions and privacy policy</span>
            </div>

            <button type="submit" class="btn">Sign Up</button>
        </form>

        <div class="switch-text">
            Already have an account? <a href="#" onclick="showForm('login-form')">Login</a>
        </div>
    </div>


    <!-- LOGIN FORM -->
    <div id="login-form" class="form-box">
        <div class="profile-icon">
            <div>🔐</div>
        </div>
        <h2>Welcome Back</h2>
        <p class="subtitle">Please login to your account.</p>
        
        <form>
            <div class="input-group">
                <label>Email Address</label>
                <div class="input-field">
                    <span>✉️</span>
                    <input type="email" placeholder="Enter your email" required>
                </div>
            </div>

            <div class="input-group">
                <label>Password</label>
                <div class="input-field">
                    <span>🔒</span>
                    <input type="password" placeholder="Enter your password" required>
                </div>
            </div>

            <div class="forgot-link">
                <a href="#" onclick="showForm('forgot-form')">Forgot Password?</a>
            </div>

            <button type="submit" class="btn">Login</button>
        </form>

        <div class="switch-text">
            Don't have an account? <a href="#" onclick="showForm('signup-form')">Sign Up</a>
        </div>
    </div>


    <!-- FORGOT PASSWORD FORM -->
    <div id="forgot-form" class="form-box">
        <div class="profile-icon">
            <div>🔑</div>
        </div>
        <h2>Reset Password</h2>
        <p class="subtitle">Enter your email to receive recovery instructions.</p>
        
        <form>
            <div class="input-group">
                <label>Email Address</label>
                <div class="input-field">
                    <span>✉️</span>
                    <input type="email" placeholder="Enter your registered email" required>
                </div>
            </div>

            <button type="submit" class="btn">Send Reset Link</button>
        </form>

        <div class="switch-text">
            Remembered your password? <a href="#" onclick="showForm('login-form')">Login</a>
        </div>
    </div>

</div>

<script>
    function showForm(formId) {
        const forms = document.querySelectorAll('.form-box');
        forms.forEach(form => {
            form.classList.remove('active');
        });
        document.getElementById(formId).classList.add('active');
    }
</script>

</body>
</html>
